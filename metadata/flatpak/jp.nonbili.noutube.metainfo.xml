<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>jp.nonbili.csoffitube</id>

  <name>CsoffiTube</name>
  <summary>YouTube and YouTube Music in a single app</summary>

  <developer id="jp.nonbili">
    <name>Nonbili Inc.</name>
  </developer>

  <metadata_license>CC-BY-SA-4.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#a599a5</color>
  </branding>

  <description>
    <ul>
      <li>Manage video/music library without login</li>
      <li>Manage watch history without login</li>
      <li>No ads</li>
      <li>Download video</li>
      <li>Hide shorts</li>
      <li>Sponsor block</li>
    </ul>
  </description>

  <keywords>
    <keyword>youtube</keyword>
    <keyword>youtube-music</keyword>
    <keyword>yt</keyword>
    <keyword>yt-music</keyword>
    <keyword>yt-dlp</keyword>
  </keywords>

  <launchable type="desktop-id">jp.nonbili.csoffitube.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/diablomike20/CsoffiTube/main/metadata/en-US/images/phoneScreenshots/1.jpg</image>
      <caption>YouTube Music</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/diablomike20/CsoffiTube/main/metadata/en-US/images/phoneScreenshots/2.jpg</image>
      <caption>YouTube</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/diablomike20/CsoffiTube/main/metadata/en-US/images/phoneScreenshots/3.jpg</image>
      <caption>YouTube Channel Feeds</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/diablomike20/CsoffiTube</url>
  <url type="vcs-browser">https://github.com/diablomike20/CsoffiTube</url>
  <url type="bugtracker">https://github.com/diablomike20/CsoffiTube/issues</url>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.3.1" date="2026-10-07">
      <description>
        <ul>
          <li>Add Discord rich presence</li>
          <li>Add ad blocking toggle and block ads in Shorts feed</li>
          <li>Improve yt-dlp output parsing and handle multi-byte characters</li>
          <li>Pre-fill current page URL in open URL dialog</li>
          <li>Resume playback queue where it left off</li>
          <li>Add bookmark and download actions to history and feed menus</li>
          <li>Persist custom playback rates</li>
          <li>Fix watch history saving</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
