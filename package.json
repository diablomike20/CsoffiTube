  "buildNumber": "6",
  "dependencies": {
    "es-toolkit": "^1.39.3"
  },
  "scripts": {
    "bundle": "bun build --target browser content/main.ts --outfile assets/scripts/main.bjs",
    "bundle:es": "esbuild --bundle content/main.ts --minify --outfile=assets/scripts/main.bjs",
    "dev": "bun bundle --watch",
